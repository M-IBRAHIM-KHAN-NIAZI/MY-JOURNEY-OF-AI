def processcommand(c):
    if "open google" in c.lower():
        webbrowser.open("https://google.com")
    elif "open facebook" in c.lower():
        webbrowser.open("https://facebook.com")
    elif "open youtube" in c.lower():
        webbrowser.open("https://youtube.com")
    elif"open freefire" in c.lower():
        webbrowser.open("https://freefire.com")
    elif c.lower() .startswith("play"):
          song=" ".join(c.lower().split(" ")[1:])
          link=musiclibrary.song[song]
          webbrowser.open(link)   
    else:
            #openai handle the rest
            output=openaiprocess(c)
            speak(output)
             

    
def speak(text):
    print(f"JARVIS: {text}")
    tts = gTTS(text=text, lang='en')
    
    filename = "jarvis_output.mp3"
    tts.save(filename)
    
    pygame.mixer.music.load(filename)
    pygame.mixer.music.play()
    
    # Jab tak audio chal rahi hai, tab tak loop ko roke rakho

    while pygame.mixer.music.get_busy():
        pygame.time.Clock().tick(10)
        
    # Audio khatam hone ke baad mixer se music unload kar do taaki file unlock ho jaye
    pygame.mixer.music.unload()
