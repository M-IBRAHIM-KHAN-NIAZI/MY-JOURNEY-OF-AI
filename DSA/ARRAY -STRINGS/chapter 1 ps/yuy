matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

def spiralOrder(matrix):
    result = []
    if not matrix:
        return result
    
    top = 0
    bottom = len(matrix) - 1
    left = 0
    right = len(matrix[0]) - 1
    
    while top <= bottom and left <= right:
        # 1. Upar wali line par left se right jao
        for i in range(left, right + 1):
            result.append(matrix[top][i])
        top += 1
        
        # 2. Right wale column par upar se neeche jao
        for i in range(top, bottom + 1):
            result.append(matrix[i][right])
        right -= 1
        
        # 3. Neeche wali line par right se left jao
        if top <= bottom:
            for i in range(right, left - 1, -1):
                result.append(matrix[bottom][i])
            bottom -= 1
            
        # 4. Left wale column par neeche se upar jao
        if left <= right:
            for i in range(bottom, top - 1, -1):
                result.append(matrix[i][left])
            left += 1
            
    return result

# VS Code mein print kar ke output check karne ke liye:
print(spiralOrder(matrix))