matrix = [
    [5, 1, 9, 11],
    [2, 4, 8, 10],
    [13, 3, 6, 7],
    [15, 14, 12, 16]
]

def rotate(matrix):
    n = len(matrix)
    
    # Layers ko upar se andar ki taraf ghumane ke liye loops
    for i in range((n + 1) // 2):
        for j in range(n // 2):
            # 4-way swapping logic
            # temp mein top-left ko save kar lo
            temp = matrix[i][j]
            
            # bottom-left ko top-left par lao
            matrix[i][j] = matrix[n - 1 - j][i]   #[3][0]      
            # bottom-right ko bottom-left par lao
            matrix[n - 1 - j][i] = matrix[n - 1 - i][n - 1 - j]  #[3][3]
            
            # top-right ko bottom-right par lao
            matrix[n - 1 - i][n - 1 - j] = matrix[j][n - 1 - i]   #[0][3]
            
            # temp (jo original top-left tha) ko top-right par daal do
            matrix[j][n - 1 - i] = temp

rotate(matrix)

# Print kar ke check karne ke liye:
for row in matrix:
    print(row)