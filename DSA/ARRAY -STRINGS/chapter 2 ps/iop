nums = [-1, 0, 1, 2, -1, -4]
result = []
n = len(nums)
nums.sort()  # Two-pointer ke liye array ko sort karna zaroori hai

for i in range(n - 2):
    # 1. Optimization: Agar value positive ho gayi, toh aage sum 0 nahi ban sakta, isliye break karo
    if nums[i] > 0:
        break
        
    # 2. Duplicate Check for 'i': Pichle element (`i-1`) se compare kar ke same starting number skip karo
    if i > 0 and nums[i] == nums[i - 1]:
        continue

    left = i + 1
    right = n - 1

    while left < right:
        total = nums[i] + nums[left] + nums[right]

        if total > 0:
            right -= 1
        elif total < 0:
            left += 1
        else:
            # Comma (,) use kiya hai taaki values math addition (+) na ho kar alag triplet banayein
            result.append([nums[i], nums[left], nums[right]])
            
            # 3. Duplicate Check for 'left': Agle element (`left+1`) se compare kar ke duplicates fast-forward karo
            while left < right and nums[left] == nums[left + 1]:
                left += 1
            # Duplicate Check for 'right': Pichle element (`right-1`) se compare karo
            while left < right and nums[right] == nums[right - 1]:
                right -= 1

            left += 1
            right -= 1

# Print statement loop ke bilkul bahar hai taaki final result sirf ek baar aaye
print(result)